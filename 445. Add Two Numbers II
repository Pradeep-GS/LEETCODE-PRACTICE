class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {

        Stack<Integer> stk1 = new Stack<>();
        Stack<Integer> stk2 = new Stack<>();

        ListNode temp = l1;
        while (temp != null) {
            stk1.push(temp.val);
            temp = temp.next;
        }

        ListNode temp2 = l2;
        while (temp2 != null) {
            stk2.push(temp2.val);
            temp2 = temp2.next;
        }

        Stack<Integer> ans = new Stack<>();

        int carry = 0;

        while (!stk1.isEmpty() || !stk2.isEmpty()) {

            int sum = carry;

            if (!stk1.isEmpty())
                sum += stk1.pop();

            if (!stk2.isEmpty())
                sum += stk2.pop();

            ans.push(sum % 10);
            carry = sum / 10;
        }

        if (carry > 0)
            ans.push(carry);

        ListNode dummy = new ListNode(0);
        ListNode curr = dummy;

        while (!ans.isEmpty()) {
            curr.next = new ListNode(ans.pop());
            curr = curr.next;
        }

        return dummy.next;
    }
}
