class Solution {
    public int diagonalSum(int[][] mat) {
        int sum =0;
        int row = mat.length;
        int col = mat[0].length;
        for(int i=0;i<row;i++)
        {
            sum = sum+mat[i][i];
            if(i!=(row-i-1))
            {
                sum+=mat[i][row-i-1];
            }
        }
        return sum;
    }
}
