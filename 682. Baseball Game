class Solution(object):
    def calPoints(self, operations):
        res=[]

        for i in operations:
            if(i=='D'):
                num1=res[-1]
                res.append(int(num1*2))
            elif(i=='C'):
                del res[-1]
            elif(i=='+'):
                num1=res[-1]
                num2=res[-2]
                res.append(int(num1+num2))
            else:
                res.append(int(i))

        return sum(res)
