class Solution {
    public char findTheDifference(String s, String t) {
        int t_sum = 0;
        int s_sum =0;
        for(int i=0;i<s.length();i++)
        {
            s_sum+=s.charAt(i);
        }
        for(int i=0;i<t.length();i++)
        {
            t_sum+=t.charAt(i);
        }
        int diff = t_sum - s_sum;
        return (char) diff;
    }
}
